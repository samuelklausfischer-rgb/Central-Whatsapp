# Modelo de android/keystore.properties — copie este arquivo para
# "keystore.properties" (sem .example) NESTA MESMA PASTA e preencha com os
# dados reais do seu keystore.
#
# ATENÇÃO: o keystore é a IDENTIDADE do app. Perder o arquivo .jks ou
# esquecer a senha impede publicar qualquer atualização do Central Whats
# PARA SEMPRE — o único caminho depois disso é lançar como um app novo,
# perdendo todos os usuários instalados. Guarde o .jks e as senhas em um
# local seguro e com backup (gerenciador de senhas, cofre, etc.).
#
# O arquivo real "keystore.properties" NUNCA vai para o Git (ver .gitignore).

# Caminho do arquivo .jks, relativo a esta pasta (android/).
# Ex.: se o .jks estiver em android/central-whats.jks, use só o nome abaixo.
storeFile=central-whats.jks

# Senha do keystore (a que você define ao rodar "keytool -genkeypair").
storePassword=SUBSTITUA_PELA_SENHA_DO_KEYSTORE

# Alias da chave dentro do keystore.
keyAlias=central-whats

# Senha da chave (pode ser igual à do keystore, mas não precisa ser).
keyPassword=SUBSTITUA_PELA_SENHA_DA_CHAVE
