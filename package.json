{
  "name": "central-whats",
  "description": "Central de atendimento WhatsApp com React, Supabase e Evolution API",
  "private": true,
  "version": "0.0.198",
  "main": "central-whats-app/main.cjs",
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:8080 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:electron": "vite build --base ./ && node central-whats-app/create-icon.cjs && electron-builder --config central-whats-app/builder.json",
    "publish:electron": "vite build --base ./ && node central-whats-app/create-icon.cjs && node central-whats-app/create-tag.cjs && electron-builder --config central-whats-app/builder.json --publish always && node central-whats-app/publish-notify.cjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "echo \"there are no tests for this project\" && exit 0",
    "test:watch": "echo \"there are no tests for this project\" && exit 0"
  },
  "dependencies": {
